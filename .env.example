# =============================================================================
# Marites PH environment variables. Copy to .env.local and fill in.
# NEVER commit .env.local. Keep this file in sync with README section 6.
# NEXT_PUBLIC_* values are sent to the browser; everything else is server-only.
# =============================================================================

# --- Phase 1: active now ------------------------------------------------------

# Public base URL, no trailing slash. Used for canonical/hreflang/OG URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL and publishable key (Dashboard > Project Settings > API Keys).
# Local: printed by `supabase start`. If left empty, the site still builds but sign-in is disabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Contact address shown for data-privacy requests (RA 10173).
NEXT_PUBLIC_CONTACT_EMAIL=privacy@example.com

# Days after which verified content shows "may be outdated" (server-only). Default 90.
CONTENT_STALE_DAYS=90

# --- Phase 3: reports and rate limiting (server-only) -------------------------

# Supabase secret key: bypasses RLS. Used ONLY by the rate limiter and to store
# anonymous "report outdated info" submissions. Never expose to the browser.
SUPABASE_SECRET_KEY=

# Salt for hashing IP addresses in rate-limit keys (16+ random characters).
# Required for anonymous reports; without it visitors must sign in to report.
RATE_LIMIT_SALT=

# --- Phase 2+: development and testing only ------------------------------------

# Enables /[locale]/ui-preview (admin components with sample data) for layout
# checks and the Playwright suite. NEVER set this in production.
ENABLE_UI_PREVIEW=false

# Set to 1 to run E2E tests that need tests/fixtures/sample-published.sql loaded.
# E2E_SAMPLE_DATA=1

# Optional: path to a preinstalled Chromium for Playwright (CI or sandboxes).
# PLAYWRIGHT_CHROMIUM_PATH=

# --- Later phases: not read by the code yet, listed so nothing is forgotten ---


# --- Phase 5: AI layer (server-only) -----------------------------------------
# AI features stay OFF unless ALL of these are set. Prices are not built in:
# copy them from Anthropic's pricing page for the model you choose, so the
# monthly budget cap is computed correctly.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
AI_MONTHLY_BUDGET_USD=
AI_INPUT_USD_PER_MTOK=
AI_OUTPUT_USD_PER_MTOK=
AI_WEB_SEARCH_USD_PER_1K=

# Web search domain lists (comma-separated; subdomains included).
OFFICIAL_SEARCH_DOMAINS=gov.ph
COMMUNITY_SEARCH_DOMAINS=reddit.com
# Live context cache lifetimes, in hours.
LIVE_CONTEXT_OFFICIAL_TTL_HOURS=24
LIVE_CONTEXT_COMMUNITY_TTL_HOURS=12

# --- Phase 6: Bantay Batas monitoring (server-only) ---------------------------
# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" to /api/cron/monitor.
# Use 16+ random characters. Without it the cron endpoint refuses every call.
CRON_SECRET=
# How the crawler identifies itself to government sites (contact address is appended).
CRAWLER_USER_AGENT=MaritesPHBot/0.1
CRAWLER_CONTACT_EMAIL=
# Reddit's own API for proactive trend monitoring. Keep false until Reddit's
# commercial-use terms are reviewed and documented in the README.
ENABLE_REDDIT_API=false

# --- Phase 7: freelancer tools (server-only) ----------------------------------
# Encrypts TIN, registered name/address, and entry notes (AES-256-GCM).
# Generate once: openssl rand -base64 32   Keep it safe: losing it makes those
# fields unreadable; rotating it needs re-encryption (see README).
FIELD_ENCRYPTION_KEY=
# Filing reminder emails (Resend). Leave empty to skip sending.
RESEND_API_KEY=
EMAIL_FROM=Marites PH <reminders@example.com>

# Phase 8: PayMongo (server-only except public key)
# Secret API key (sk_test_... for test mode, sk_live_... for live). Server-only.
PAYMONGO_SECRET_KEY=
# The webhook's own signing secret (whsk_...), shown when you create the webhook
# in PayMongo (Settings -> Webhooks, event checkout_session.payment.paid). NOT the API key.
PAYMONGO_WEBHOOK_SECRET=
# Payment methods offered at checkout (must be enabled in your PayMongo account).
PAYMONGO_PAYMENT_METHODS=gcash,paymaya,card,qrph

# --- Phase 11: optional analytics ---------------------------------------------
# "vercel" turns on cookieless Vercel Web Analytics (aggregate page views, no
# personal data). Leave empty to keep analytics off. Mention it in the privacy policy.
NEXT_PUBLIC_ANALYTICS=
